# Copy this file to: ~/.config/daily-summarize/secrets.env
# Then fill your own values and run: chmod 600 ~/.config/daily-summarize/secrets.env

# Account: WORK
WORK_GMAIL_CLIENT_ID=
WORK_GMAIL_CLIENT_SECRET=
WORK_GMAIL_REFRESH_TOKEN=

# Account: PERSONAL
PERSONAL_GMAIL_CLIENT_ID=
PERSONAL_GMAIL_CLIENT_SECRET=
PERSONAL_GMAIL_REFRESH_TOKEN=

# Optional Slack (required only when digest.channels includes slack_bot)
SLACK_BOT_TOKEN=

# Optional LINE (required only when digest.channels includes line)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_USER_ID=
